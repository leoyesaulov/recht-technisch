<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recht Technisch Password Check</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <h1>Connection check</h1>
      <button id="check-password-btn" type="button">Check password</button>
    </main>

    <div id="password-modal" class="modal hidden" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-content">
        <h2 id="modal-title">Password received</h2>
        <p id="password-value">—</p>
        <button id="close-modal-btn" type="button">Close</button>
      </div>
    </div>

    <script src="/app.js"></script>
  </body>
</html>
